# Hotmart Webhook Secret (Hottok)
HOTMART_WEBHOOK_SECRET=your_hotmart_webhook_secret

# Resend API Key
RESEND_API_KEY=your_resend_api_key

# Sender Email (use resend.dev for testing)
FROM_EMAIL=María 365 <no-reply@pasoafuturo.com>

# App URL (where the app is hosted)
APP_URL=https://maria365.vercel.app/app.html

# Firebase (already hardcoded, but can be overridden)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=maria-365.firebaseapp.com
FIREBASE_DATABASE_URL=https://maria-365-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=maria-365
FIREBASE_STORAGE_BUCKET=maria-365.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
